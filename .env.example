# MacroZone app environment (Expo)
#
# Copy this file to `.env.local` (git-ignored) and fill in your own values.
# Every EXPO_PUBLIC_* variable is compiled into the app bundle and can be read by
# anyone who has the app. Never put a secret here: no service-role key, no
# database password, no JWT signing secret, no management token.

# --- AI meal estimates (optional) ------------------------------------------
# Public HTTPS URL of your own MacroZone AI service. Leave empty to disable AI.
EXPO_PUBLIC_AI_ENDPOINT_URL=

# --- Open Food Facts barcode lookup (optional) -----------------------------
# Public contact for the required User-Agent header: an email address or HTTPS
# page meant to be public (project support mailbox, issue tracker).
# Placeholder domains such as example.com are rejected.
EXPO_PUBLIC_OPEN_FOOD_FACTS_CONTACT=
# production | staging (defaults: staging in development builds, production in release builds)
EXPO_PUBLIC_OPEN_FOOD_FACTS_ENV=

# --- Accounts and cloud backup (optional) ----------------------------------
# Your Supabase project URL, https only.
EXPO_PUBLIC_SUPABASE_URL=
# The project's PUBLISHABLE (anon) key - the key meant to ship in clients.
# MacroZone refuses to start cloud backup if this looks like a secret or
# service-role key. Without both variables the app stays in local-only mode.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
